{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,

    // Relative `paths` values resolve against this file's own directory, so
    // no `baseUrl` is needed — which matters because TS 6.0 deprecates
    // `baseUrl` ahead of its removal in TS 7.0.
    "paths": {
      "@core/*": ["./src/core/*"],
      "@app/*": ["./src/app/*"],
      "@tests/*": ["./tests/*"]
    }
  }
}
